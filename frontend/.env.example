# Base URL of the HandScribe backend API (FastAPI). Local dev default shown.
# On Vercel, set this to your deployed Railway backend URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# OAuth 2.0 Client ID from Google Cloud Console — same value as the
# backend's GOOGLE_OAUTH_CLIENT_ID. Leave unset to hide the Google sign-in
# button; email/password auth still works either way.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
